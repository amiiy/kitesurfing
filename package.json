{
  "name": "kite-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "optimize:models": "gltf-transform optimize --compress meshopt --texture-compress webp --texture-size 2048 --simplify-ratio 0.045 --simplify-error 0.01",
    "optimize:rider": "gltf-transform optimize --compress meshopt --texture-compress webp --texture-size 2048 --simplify false --flatten false --join false",
    "sim:check": "node scripts/sim-check.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "vite": "^6.0.0"
  }
}
